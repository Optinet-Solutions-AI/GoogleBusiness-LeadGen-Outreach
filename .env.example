# Copy to .env and fill in real values. Never commit .env.

# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Supabase (Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Scraping providers ---
# At least one of these is required. Pick which one a batch uses via batches.scraper.
# Default is google_places (since that's what we have on the pilot).

# Outscraper — pay-per-lead Google Maps scraper (~$3/1k). Best at scale.
OUTSCRAPER_API_KEY=

# Google Places API (New) — official, $200/mo free credit, ~$35/1k Text Search Pro.
# Get a key at: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DEFAULT_REGION=us
GOOGLE_PLACES_DEFAULT_LANGUAGE=en

# Apify — Google Maps scraper that also website-crawls emails + social links (FB/IG).
# ~$1.5–2.1/1k places; async actor API. Token: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# --- Google Gemini (site copy generation) ---
# Free tier: 1,500 req/day on Flash. Same Google Cloud project as Places.
# Get a key: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# --- Google Custom Search API (finds FB/IG URLs for social-only leads) ---
# Setup (~10 min, one-time):
#   1. Enable Custom Search API at
#      https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#   2. Create a Programmable Search Engine at
#      https://programmablesearchengine.google.com/  — scope it to
#      facebook.com + instagram.com (one entry per site, "Search the
#      entire web" off).
#   3. Paste the "Search engine ID" (cx) into GOOGLE_CSE_ID below.
#   4. Reuse GOOGLE_PLACES_API_KEY if unrestricted; else create a new key
#      with Custom Search API enabled.
# Free quota: 100 queries/day. Each lead uses up to 2 queries (FB + IG).
# When unset, social-search soft-fails to null → falls through to monogram.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --- Residential proxy (for Playwright FB/IG fetches) ---
# Cloud Run's egress IPs are on FB+IG's bot block list. Routing Playwright
# through a residential-IP proxy bypasses this — we verified Proxy Lite +
# Enigma both return real og:image content where direct Cloud Run requests
# got login walls / stripped pages.
#
# USERNAME_TEMPLATE supports a literal {COUNTRY} substring that gets
# replaced per-request with the lead's batch.country_code (uppercased).
# Most residential proxy vendors use this convention to scope egress IPs
# to a specific country. Example formats by vendor:
#   Proxy Lite:  pl-<id>_area-{COUNTRY}
#   Enigma:      <user>_country-{COUNTRY}
#   Proxio:      <user>-region-{COUNTRY}
#
# All four blank → no proxy, direct fetch (will fail for FB/IG from
# Cloud Run, but stays harmless in local dev).
PROXY_SERVER=
PROXY_USERNAME_TEMPLATE=
PROXY_PASSWORD=
PROXY_DEFAULT_COUNTRY=us

# --- Cloudflare Pages (hosting) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_ROOT_DOMAIN=

# --- Cloud Run Jobs (long-running pipeline runner) ---
# When all five are set, POST /api/batches/:id/run hands off to a Cloud Run
# Job execution instead of running inline (which has a 60s Vercel cap).
# Leave any blank to fall back to the inline path (fine for local dev).
#
# Auth is via Workload Identity Federation — Vercel's per-invocation OIDC
# token is exchanged at GCP STS for a short-lived access token. No JSON keys.
# Run scripts/setup-wif.sh once to provision and get the values below.
GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_JOB_NAME=lead-batch-runner
# vercel-trigger-sa@<project>.iam.gserviceaccount.com
GCP_SERVICE_ACCOUNT_EMAIL=
# Full resource path:
#   projects/<num>/locations/global/workloadIdentityPools/<pool>/providers/<prov>
GCP_WORKLOAD_IDENTITY_PROVIDER=

# --- Instantly.ai (cold email) ---
INSTANTLY_API_KEY=
INSTANTLY_FROM_EMAIL=

# --- Stripe (billing — later) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email verification (optional; gate is off until ZEROBOUNCE_API_KEY is set) ---
ZEROBOUNCE_API_KEY=
MILLIONVERIFIER_API_KEY=
HUNTER_API_KEY=
HUNTER_MAX_CALLS_PER_HOUR=20
SMTP_PROBE_HELO=optiratesolutions.com
SMTP_PROBE_FROM=verify@optiratesolutions.com
