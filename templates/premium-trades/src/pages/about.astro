---
import Base from "../layouts/Base.astro";
import data from "../lib/data";
import SoftScrapbook from "../components/about/soft-scrapbook.astro";
import StatLed from "../components/about/stat-led.astro";
import MagazineColumn from "../components/about/magazine-column.astro";

const c = data.copy;

// Pick the about layout based on the picked variant. Picker chooses a
// niche-appropriate default; AI can override; fallback handled below.
// soft-scrapbook  → photogenic / boutique (event, florist, beauty, spa, food)
// stat-led        → trades / professional / automotive (proof-led)
// magazine-column → editorial / vintage / real-estate / home-decor (story-led)
const variants = data.variants as { about?: "soft-scrapbook" | "stat-led" | "magazine-column" } & typeof data.variants;
const aboutVariant = variants.about ?? "stat-led";
const ABOUT_LAYOUTS = {
  "soft-scrapbook": SoftScrapbook,
  "stat-led": StatLed,
  "magazine-column": MagazineColumn,
} as const;
const AboutLayout = ABOUT_LAYOUTS[aboutVariant] ?? StatLed;
---
<Base title="About" description={c.about_paragraph.slice(0, 155)}>
  <AboutLayout data={data} />
</Base>
