---
import Base from "../../layouts/Base.astro";
import data from "../../lib/data";
import EditorialMagazine from "../../components/service-detail/editorial-magazine.astro";
import PhotoHeroOverlay from "../../components/service-detail/photo-hero-overlay.astro";
import ProcessStepper from "../../components/service-detail/process-stepper.astro";
import GalleryShowcase from "../../components/service-detail/gallery-showcase.astro";
import FaqForward from "../../components/service-detail/faq-forward.astro";

export function getStaticPaths() {
  return data.copy.services.map((s, i) => ({
    params: { slug: s.slug },
    props: { service: s, serviceIndex: i },
  }));
}

const { service, serviceIndex } = Astro.props;

// 5 layouts rotate through service positions. Each lead also gets an
// offset (variants.service_detail_offset, 0–4) so two leads with the
// same service count don't share identical rotation. The offset is
// persisted on the lead row so subsequent rebuilds are deterministic.
// Index 0 → editorial-magazine, 1 → photo-hero-overlay, 2 → process-
// stepper, 3 → gallery-showcase, 4 → faq-forward, then cycles.
const LAYOUTS = [
  EditorialMagazine,
  PhotoHeroOverlay,
  ProcessStepper,
  GalleryShowcase,
  FaqForward,
] as const;

const variants = data.variants as { service_detail_offset?: number } & typeof data.variants;
const offset = typeof variants?.service_detail_offset === "number" ? variants.service_detail_offset : 0;
const Layout = LAYOUTS[((serviceIndex ?? 0) + offset) % LAYOUTS.length];

// Pick a distinct photo per service from the lead's photo array.
const photo = data.photos[(serviceIndex ?? 0) % Math.max(data.photos.length, 1)] ?? null;
const others = data.copy.services.filter((s) => s.slug !== service.slug);
---
<Base title={service.name} description={service.short_description}>
  <Layout service={service} data={data} photo={photo} />

  {/* "Other services" closer — kept consistent across layouts so the
      cross-link footprint stays predictable for SEO + UX. */}
  {others.length > 0 && (
    <section class="container-tight pb-24">
      <h2 class="text-2xl font-bold text-ink mb-6">Other services</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {others.map((s) => (
          <a href={`/services/${s.slug}`} class="block p-6 rounded-2xl bg-surface-alt hover:-translate-y-0.5 hover:shadow-xl hover:shadow-ink/5 transition-all">
            <div class="font-bold text-ink">{s.name}</div>
            <div class="mt-2 text-sm text-ink-muted line-clamp-2">{s.short_description}</div>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
