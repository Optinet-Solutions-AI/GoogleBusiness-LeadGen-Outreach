---
/**
 * soft-scrapbook.astro — About variant for boutique / event / florist /
 * beauty / spa / food niches. Asymmetric photo collage with slight
 * rotation (the "scrapbook feel" from the editorial research). Body
 * copy weaves around the photos. Warm and approachable.
 *
 * Props: { data }
 */
import type { SiteData } from "../../lib/data";
const { data } = Astro.props as { data: SiteData };
const c = data.copy;
const photos = (data.photos ?? []).slice(0, 4);
---
<article class="container-tight py-16 md:py-24">
  <header class="max-w-3xl">
    <span class="eyebrow">About</span>
    <h1 class="mt-3 font-heading text-5xl md:text-7xl font-semibold tracking-tighter-2 leading-[1.05] text-ink">
      {data.business_name}
    </h1>
  </header>

  <div class="mt-12 grid lg:grid-cols-12 gap-10 lg:gap-14">
    {/* LEFT — body + bullet list */}
    <div class="lg:col-span-7">
      <p class="text-xl md:text-2xl text-ink-muted leading-[1.5] max-w-xl">
        {c.about_paragraph}
      </p>

      {c.about_why_us?.length > 0 && (
        <div class="mt-12">
          <h2 class="font-heading text-2xl md:text-3xl font-semibold text-ink tracking-tight">
            Little things we care about
          </h2>
          <ul class="mt-6 space-y-4">
            {c.about_why_us.map((b, i) => (
              <li class="flex items-start gap-4 group">
                <span
                  class="mt-1 font-heading font-semibold text-2xl tabular-nums leading-none transition-transform group-hover:scale-110"
                  style="color:rgb(var(--c-primary))"
                >
                  ·
                </span>
                <span class="text-ink leading-relaxed">{b}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {/* RIGHT — asymmetric photo collage, slight rotation. Photos sized
        and tilted intentionally so it reads as hand-laid not 3-up grid. */}
    {photos.length > 0 && (
      <div class="lg:col-span-5 relative min-h-[480px] md:min-h-[600px]">
        {photos[0] && (
          <figure class="absolute top-0 left-0 w-[65%] aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl shadow-ink/10 rotate-[-2deg] hover:rotate-0 transition-transform duration-500">
            <img src={photos[0]} alt="" loading="lazy" width="500" height="625" class="w-full h-full object-cover" />
          </figure>
        )}
        {photos[1] && (
          <figure class="absolute top-[10%] right-0 w-[50%] aspect-square rounded-3xl overflow-hidden shadow-2xl shadow-ink/10 rotate-[3deg] hover:rotate-0 transition-transform duration-500">
            <img src={photos[1]} alt="" loading="lazy" width="500" height="500" class="w-full h-full object-cover" />
          </figure>
        )}
        {photos[2] && (
          <figure class="absolute bottom-[8%] left-[12%] w-[55%] aspect-[3/4] rounded-3xl overflow-hidden shadow-2xl shadow-ink/10 rotate-[1.5deg] hover:rotate-0 transition-transform duration-500">
            <img src={photos[2]} alt="" loading="lazy" width="500" height="666" class="w-full h-full object-cover" />
          </figure>
        )}
        {photos[3] && (
          <figure class="absolute bottom-0 right-[5%] w-[40%] aspect-square rounded-3xl overflow-hidden shadow-2xl shadow-ink/10 rotate-[-3deg] hover:rotate-0 transition-transform duration-500">
            <img src={photos[3]} alt="" loading="lazy" width="400" height="400" class="w-full h-full object-cover" />
          </figure>
        )}
      </div>
    )}
  </div>
</article>
