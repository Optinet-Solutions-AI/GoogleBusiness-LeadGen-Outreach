---
/**
 * about-block.astro — Editorial "about" section for the HOME page.
 *
 * Distinct from /about which is a full page with its own variants
 * (soft-scrapbook / stat-led / magazine-column). This is a tighter
 * block that sits inline on the home flow for niches where the story
 * should hit early — vintage, retail, boutique, event-services,
 * beauty/spa, real-estate.
 *
 * Layout: split — body copy on the left, asymmetric photo pair on the
 * right. No second-headline-page-feel; behaves as a SECTION not a
 * stand-alone composition.
 *
 * Props: { data }
 */
import type { SiteData } from "../../lib/data";
const { data } = Astro.props as { data: SiteData };
const c = data.copy;
const photos = (data.photos ?? []).slice(0, 2);
const cityFrom = data.address?.split(",").slice(-2, -1)[0]?.trim();
---
<section class="container-tight py-20 md:py-24" id="about">
  <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    {/* LEFT — copy */}
    <div class="lg:col-span-7">
      <span class="eyebrow">The story</span>
      <h2 class="mt-3 font-heading text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tighter-2 leading-[1.05] text-ink">
        Who we are
      </h2>
      <p class="mt-6 text-lg md:text-xl text-ink-muted leading-relaxed max-w-2xl">
        {c.about_paragraph}
      </p>

      {c.about_why_us?.length > 0 && (
        <ul class="mt-8 space-y-3 max-w-xl">
          {c.about_why_us.slice(0, 3).map((b) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-2 inline-block w-1.5 h-1.5 rounded-full shrink-0"
                style="background:rgb(var(--c-primary))"
              ></span>
              <span class="text-ink leading-relaxed">{b}</span>
            </li>
          ))}
        </ul>
      )}

      <a
        href="/about"
        class="mt-10 inline-flex items-center gap-2 font-semibold text-ink hover:gap-3 transition-all"
        style="color:rgb(var(--c-primary))"
      >
        Read the full story
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    {/* RIGHT — asymmetric photo pair (or single photo / typographic
        fallback when photos are sparse). */}
    {photos.length > 0 ? (
      <div class="lg:col-span-5 relative min-h-[420px] md:min-h-[520px]">
        {photos[0] && (
          <figure class="absolute top-0 right-0 w-[75%] aspect-[4/5] rounded-3xl overflow-hidden shadow-xl shadow-ink/10">
            <img
              src={photos[0]}
              alt=""
              loading="lazy"
              width="500"
              height="625"
              class="w-full h-full object-cover"
            />
          </figure>
        )}
        {photos[1] && (
          <figure class="absolute bottom-0 left-0 w-[55%] aspect-square rounded-3xl overflow-hidden shadow-xl shadow-ink/10 ring-4 ring-surface">
            <img
              src={photos[1]}
              alt=""
              loading="lazy"
              width="400"
              height="400"
              class="w-full h-full object-cover"
            />
          </figure>
        )}
      </div>
    ) : (
      <div
        class="lg:col-span-5 rounded-3xl p-10 md:p-14 text-center"
        style="background:rgb(var(--c-primary) / 0.06)"
      >
        <div
          class="font-heading text-5xl md:text-7xl font-bold tracking-tighter-2"
          style="color:rgb(var(--c-primary))"
        >
          {cityFrom ?? "Local"}
        </div>
        <p class="mt-3 text-sm uppercase tracking-[0.2em] text-ink-muted">
          Home base
        </p>
      </div>
    )}
  </div>
</section>
