---
import data from "../lib/data";
import { telHref } from "../lib/format";
const phone = data.phone;
const services = data.copy.services;

// Google Business names frequently bake the niche + city into the display
// name ("The Little Things | Balloon Garlands & Event Styling Hamilton"),
// which blows out a sticky header on 390px screens. We split on the first
// separator the owner used (pipe / em-dash / en-dash / hyphen / colon)
// and keep the leading segment — that's almost always the actual brand.
// The 22-char cap guards against un-punctuated names that are still long.
const SEPARATOR_RE = /\s+(?:\||–|—|-|:)\s+/;
const fullName = data.business_name;
const firstSegment = fullName.split(SEPARATOR_RE)[0].trim();
const shortName = firstSegment.length <= 22 ? firstSegment : firstSegment.slice(0, 20).trim() + "…";
---
<header
  id="site-header"
  class="sticky top-0 z-40 backdrop-blur bg-surface/85 border-b border-ink/5 transition-all"
  data-shrink-on-scroll
  data-opaque-on-scroll
>
  <div class="container-tight flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 font-heading font-bold text-lg tracking-tight text-ink min-w-0 flex-1 lg:flex-initial">
      {data.logo_url ? (
        <img src={data.logo_url} alt={`${data.business_name} logo`} class="w-10 h-10 sm:w-9 sm:h-9 rounded-lg object-cover shrink-0" />
      ) : (
        <span class="grid place-items-center w-8 h-8 rounded-lg bg-brand text-brand-text text-sm shrink-0">
          {data.business_name[0]}
        </span>
      )}
      {/* Brand text scales DOWN on mobile so the short brand still fits
          beside the logo + pill CTA on a 390px header without truncating.
          - below sm:  short brand at text-sm (14px) — fits ~16 chars cleanly
          - sm to lg:  short brand at text-base (16px)
          - lg+:       full Google-Business name at the layout's default
                       text-lg (18px). */}
      <span class="lg:hidden truncate text-sm sm:text-base">{shortName}</span>
      <span class="hidden lg:inline">{fullName}</span>
    </a>
    <nav class="hidden md:flex items-center gap-5 lg:gap-8 text-sm font-medium">
      <a href="/" class="text-ink hover:text-brand">Home</a>
      <div class="relative group">
        <button class="text-ink hover:text-brand inline-flex items-center gap-1">
          Services
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="absolute right-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
          <div class="bg-surface rounded-2xl shadow-2xl shadow-ink/10 border border-ink/5 p-2 w-64">
            {services.map((s) => (
              <a href={`/services/${s.slug}`} class="block px-4 py-3 rounded-xl hover:bg-surface-alt text-ink">
                <div class="font-semibold text-sm">{s.name}</div>
                <div class="text-xs text-ink-muted line-clamp-1">{s.short_description}</div>
              </a>
            ))}
          </div>
        </div>
      </div>
      <a href="/about" class="text-ink hover:text-brand">About</a>
      <a href="/service-area" class="text-ink hover:text-brand">Areas</a>
      <a href="/contact" class="text-ink hover:text-brand">Contact</a>
    </nav>
    <div class="flex items-center gap-3 shrink-0">
      {phone && (
        <a href={telHref(phone)} class="hidden lg:inline-flex items-center gap-2 text-sm font-semibold text-ink hover:text-brand whitespace-nowrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {phone}
        </a>
      )}
      {/* On md (tablet), drop to a compact icon-only phone link so the row
          doesn't blow out the header. Full phone reappears at lg. */}
      {phone && (
        <a href={telHref(phone)} aria-label={`Call ${phone}`} class="hidden md:inline-flex lg:hidden items-center justify-center w-9 h-9 rounded-full border border-ink/15 text-ink hover:text-brand hover:border-brand transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      )}
      <a href="/contact" class="btn-primary text-sm py-2 px-4 whitespace-nowrap">{data.copy.cta_primary}</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 24;
    header.classList.toggle("h-14", scrolled);
    header.classList.toggle("shadow-sm", scrolled);
    // Solid surface once scrolled — when transparent, large hero headlines
    // visibly bleed THROUGH the sticky header as the page scrolls them
    // into the header zone. Switching to a fully opaque surface kills the
    // bleed-through without affecting initial top-of-page aesthetics.
    header.classList.toggle("bg-surface/85", !scrolled);
    header.classList.toggle("bg-surface", scrolled);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
